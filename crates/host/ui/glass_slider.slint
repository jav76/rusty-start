/// Horizontal slider from `minimum` to `maximum`. Rust owns `value`; the slider reports each change.
export component GlassSlider inherits Rectangle {
    in property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 5;
    in property <bool> enabled: true;
    in property <string> label;

    callback changed(float);

    property <float> fraction: (clamp(root.value, root.minimum, root.maximum) - root.minimum) / max(1, root.maximum - root.minimum);
    property <length> knob-size: 18px;
    property <length> track-width: root.width - root.knob-size;

    height: 28px;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-value: round(root.value);
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: root.step;
    accessible-action-increment => {
        root.nudge(1);
    }
    accessible-action-decrement => {
        root.nudge(-1);
    }

    function set(value: float) {
        if (root.enabled) {
            root.changed(clamp(round(value), root.minimum, root.maximum));
        }
    }

    function nudge(direction: int) {
        root.set(root.value + direction * root.step);
    }

    function set-from-x(x: length) {
        root.set(root.minimum + clamp((x - root.knob-size / 2) / root.track-width, 0, 1) * (root.maximum - root.minimum));
    }

    Rectangle {
        x: root.knob-size / 2;
        y: (parent.height - self.height) / 2;
        width: root.track-width;
        height: 4px;
        border-radius: 2px;
        background: #ffffff1e;

        Rectangle {
            x: 0;
            width: parent.width * root.fraction;
            border-radius: 2px;
            background: root.enabled ? #7cc8ffaa : #ffffff22;
        }
    }

    Rectangle {
        x: root.track-width * root.fraction;
        y: (parent.height - self.height) / 2;
        width: root.knob-size;
        height: root.knob-size;
        border-radius: self.height / 2;
        background: root.enabled ? #f6f9ff : #c8daf844;
        border-width: focus.has-focus ? 2px : 0px;
        border-color: #9be2ff;
    }

    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.LeftArrow || event.text == Key.DownArrow) {
                root.nudge(-1);
                return accept;
            }
            if (event.text == Key.RightArrow || event.text == Key.UpArrow) {
                root.nudge(1);
                return accept;
            }
            if (event.text == Key.Home) {
                root.set(root.minimum);
                return accept;
            }
            if (event.text == Key.End) {
                root.set(root.maximum);
                return accept;
            }
            reject
        }
    }

    TouchArea {
        enabled: root.enabled;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                focus.focus();
                root.set-from-x(self.mouse-x);
            }
        }
        moved => {
            if (self.pressed) {
                root.set-from-x(self.mouse-x);
            }
        }
    }
}
