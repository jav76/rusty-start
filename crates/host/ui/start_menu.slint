import { ListView } from "std-widgets.slint";
import { ActionFlyout } from "action_flyout.slint";
import { GearGlyph } from "gear_glyph.slint";
import { MenuRow, MenuRowView, RowKind } from "menu_row.slint";
import { PowerFlyout } from "power_flyout.slint";
import { PowerGlyph } from "power_glyph.slint";
import { MetaKeyStatus, SettingsPage, SetupRow, SetupState, SetupStatus } from "settings_page.slint";

export { MenuRow, MetaKeyStatus, RowKind, SetupRow, SetupState, SetupStatus }

export enum Page {
    apps,
    settings,
}

export component StartMenu inherits Window {
    in-out property <string> query;
    in property <[MenuRow]> rows;
    in property <[string]> power-labels;
    in-out property <int> selected-index: 0;
    property <length> row-height: 48px;
    property <bool> power-open: false;
    in property <[string]> action-labels;
    property <bool> actions-open: false;
    property <int> action-row: 0;
    property <int> action-index: 0;

    in property <length> monitor-width: 1440px;
    in property <length> monitor-height: 900px;
    in property <length> card-x: 48px;
    in property <length> card-y: 90px;
    in property <float> progress: 0.0;
    // Same cubic-out curve the glass shader applies, so the card content moves with the glass body.
    property <float> ease: 1.0 - (1.0 - root.progress) * (1.0 - root.progress) * (1.0 - root.progress);
    in-out property <Page> page: Page.apps;

    in property <int> anchor-index;
    in property <int> veil-mode;
    in property <float> veil-blur;
    in property <MetaKeyStatus> meta-key;
    in property <string> meta-key-label;
    in property <SetupStatus> setup;

    callback dismiss();
    callback search(string);
    callback launch(int);
    callback toggle-pin(int);
    callback open-actions(int);
    callback choose-action(int);
    callback run-as-administrator(int);
    callback power(int);
    callback open-settings();
    callback choose-anchor(int);
    callback choose-veil-mode(int);
    callback set-veil-blur(float);
    callback set-meta-key(bool);
    callback install-setup();
    callback undo-setup();

    /// Returns to the app list, clears the query, restores the full list and scrolls back to the top.
    public function reset-search() {
        root.page = Page.apps;
        root.query = "";
        root.search("");
        root.power-open = false;
        root.actions-open = false;
        list.content-y = 0px;
        root.select(0, 1);
        search-input.focus();
    }

    function show-apps() {
        root.page = Page.apps;
        search-input.focus();
    }

    function toggle-settings() {
        root.power-open = false;
        root.actions-open = false;
        if (root.page == Page.settings) {
            root.show-apps();
        } else {
            root.page = Page.settings;
            root.open-settings();
        }
    }

    /// Opens the App Action Flyout for the app in `row`. Rust sets `action-labels` first.
    public function show-actions(row: int) {
        root.power-open = false;
        root.select(row, 1);
        root.action-row = row;
        root.action-index = 0;
        root.actions-open = true;
    }

    function close-actions() {
        root.actions-open = false;
        search-input.focus();
    }

    function choose-flyout-action(index: int) {
        root.actions-open = false;
        root.choose-action(index);
    }

    /// Keys while the App Action Flyout is open. Every key is consumed, so typing never edits the
    /// search behind the flyout.
    function handle-action-key(event: KeyEvent) -> EventResult {
        let count = root.action-labels.length;
        if (event.text == Key.Escape || event.text == Key.Menu || (event.modifiers.shift && event.text == Key.F10)) {
            root.close-actions();
        } else if (event.text == Key.DownArrow) {
            root.action-index = Math.mod(root.action-index + 1, count);
        } else if (event.text == Key.UpArrow) {
            root.action-index = Math.mod(root.action-index + count - 1, count);
        } else if (event.text == Key.Home) {
            root.action-index = 0;
        } else if (event.text == Key.End) {
            root.action-index = count - 1;
        } else if (event.text == Key.Return || event.text == " ") {
            root.choose-flyout-action(root.action-index);
        }
        accept
    }

    public function focus-search() {
        search-input.focus();
    }

    /// Selects `index`, or the nearest selectable row past it, and scrolls it into view.
    public function select-row(index: int) {
        root.select(index, 1);
    }

    /// Selects the row at `index`, stepping over a section header in `direction` (1 or -1).
    /// Headers are never adjacent and never last, so one step always lands on a selectable row.
    function select(index: int, direction: int) {
        if (root.rows.length <= 0) {
            root.selected-index = 0;
            return;
        }

        let clamped = max(0, min(index, root.rows.length - 1));
        let target = root.rows[clamped].kind != RowKind.header
            ? clamped
            : (direction < 0 && clamped > 0 ? clamped - 1 : clamped + 1);
        root.selected-index = target;

        // Moving up reveals the header above the first row of a section.
        let reveal-top = target > 0 && root.rows[target - 1].kind == RowKind.header
            ? (target - 1) * root.row-height
            : target * root.row-height;
        let row-bottom = (target + 1) * root.row-height;
        let visible-top = -list.content-y;
        let visible-bottom = visible-top + list.visible-height;

        if (reveal-top < visible-top) {
            list.content-y = -reveal-top;
        } else if (row-bottom > visible-bottom) {
            list.content-y = -(row-bottom - list.visible-height);
        }
    }

    title: "Rusty Start";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    width: root.monitor-width;
    height: root.monitor-height;
    forward-focus: key-scope;

    key-scope := FocusScope {
        width: 100%;
        height: 100%;

        // Capture runs before the focused search field sees the key, so these keys always reach
        // the menu while the text cursor stays in the search field.
        capture-key-pressed(event) => {
            if (root.actions-open) {
                return root.handle-action-key(event);
            }
            if (event.text == Key.Escape) {
                if (root.power-open) {
                    root.power-open = false;
                } else if (root.page == Page.settings) {
                    root.show-apps();
                } else {
                    root.dismiss();
                }
                return accept;
            }
            if (event.modifiers.control && event.text == ",") {
                root.toggle-settings();
                return accept;
            }
            if (root.page != Page.apps) {
                return reject;
            }
            if (event.text == Key.DownArrow) {
                root.select(root.selected-index + 1, 1);
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.select(root.selected-index - 1, -1);
                return accept;
            }
            if (event.modifiers.control && (event.text == "p" || event.text == "P")) {
                root.toggle-pin(root.selected-index);
                return accept;
            }
            if (event.text == Key.Menu || (event.modifiers.shift && event.text == Key.F10)) {
                root.open-actions(root.selected-index);
                return accept;
            }
            if (event.text == Key.Return && event.modifiers.control && event.modifiers.shift) {
                root.run-as-administrator(root.selected-index);
                return accept;
            }
            if (event.text == Key.Return) {
                root.launch(root.selected-index);
                return accept;
            }
            reject
        }

        // Clicking anywhere on the outer Fog Veil dismisses the Start menu.
        backdrop-touch := TouchArea {
            width: 100%;
            height: 100%;
            clicked => {
                root.dismiss();
            }
        }

        // Floating 640x720 Liquid-Glass Card container. The GPU underlay shader draws the
        // refracted glass body, chromatic bevel and specular rim directly behind this rect.
        card := Rectangle {
            x: root.card-x;
            y: root.card-y + (1.0 - root.ease) * 16px;
            width: 640px;
            height: 720px;
            transform-scale: 0.92 + 0.08 * root.ease;
            opacity: clamp(root.ease * 1.15, 0.0, 1.0);
            background: transparent;

            // Absorbs pointer clicks inside the card so they do not trigger `backdrop-touch`.
            TouchArea {
                width: 100%;
                height: 100%;
            }

            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                HorizontalLayout {
                    height: 48px;
                    spacing: 12px;

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 48px;

                    // Translucent glass search capsule.
                    Rectangle {
                        width: 100%;
                        height: 100%;
                        visible: root.page == Page.apps;
                        border-radius: 16px;
                        background: search-input.has-focus ? #ffffff22 : #ffffff16;
                        border-width: 1px;
                        border-color: search-input.has-focus ? #9be2ff88 : #ffffff36;

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 10px;

                            Text {
                                text: "⌕";
                                color: #b8d4ff;
                                font-size: 18px;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                height: 100%;

                                if (root.query == "") : Text {
                                    width: 100%;
                                    height: 100%;
                                    text: "Search apps";
                                    color: #c8daf899;
                                    font-size: 16px;
                                    vertical-alignment: center;
                                }

                                search-input := TextInput {
                                    width: 100%;
                                    height: 100%;
                                    enabled: root.page == Page.apps;
                                    text <=> root.query;
                                    color: #f6f9ff;
                                    font-size: 16px;
                                    vertical-alignment: center;
                                    single-line: true;
                                    edited => {
                                        root.search(self.text);
                                        list.content-y = 0px;
                                        root.select(0, 1);
                                    }
                                    accepted => {
                                        root.launch(root.selected-index);
                                    }
                                }
                            }
                        }
                    }

                    if root.page == Page.settings: HorizontalLayout {
                        spacing: 10px;

                        Rectangle {
                            width: 40px;
                            height: 40px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 12px;
                            background: back-touch.has-hover ? #ffffff22 : transparent;
                            accessible-role: button;
                            accessible-label: "Back to apps";
                            accessible-action-default => {
                                root.show-apps();
                            }

                            Path {
                                width: 18px;
                                height: 18px;
                                viewbox-width: 24;
                                viewbox-height: 24;
                                commands: "M 15 5 L 8 12 L 15 19";
                                stroke: #b8d4ff;
                                stroke-width: 2px;
                                stroke-line-cap: round;
                                stroke-line-join: round;
                                fill: transparent;
                            }

                            back-touch := TouchArea {
                                clicked => {
                                    root.show-apps();
                                }
                            }
                        }

                        Text {
                            horizontal-stretch: 1;
                            text: "Settings";
                            color: #f6f9ff;
                            font-size: 18px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                    }

                    Rectangle {
                        width: 48px;
                        height: 48px;
                        border-radius: 16px;
                        background: root.page == Page.settings ? #ffffff2c : (gear-touch.has-hover ? #ffffff22 : #ffffff16);
                        border-width: 1px;
                        border-color: gear-touch.has-hover || root.page == Page.settings ? #9be2ff77 : #ffffff30;
                        accessible-role: button;
                        accessible-label: "Settings";
                        accessible-action-default => {
                            root.toggle-settings();
                        }

                        GearGlyph {
                            width: 22px;
                            height: 22px;
                            tint: root.page == Page.settings ? #9be2ff : #b8d4ff;
                        }

                        gear-touch := TouchArea {
                            clicked => {
                                root.toggle-settings();
                            }
                        }
                    }
                }

                list-area := Rectangle {
                    vertical-stretch: 1;

                // Virtualized translucent glass app list.
                list := ListView {
                    width: 100%;
                    height: 100%;
                    visible: root.page == Page.apps;

                    for item[index] in root.rows: MenuRowView {
                        height: root.row-height;
                        width: parent.width;
                        entry: item;
                        selected: index == root.selected-index;
                        activate => {
                            root.selected-index = index;
                            root.launch(index);
                        }
                        toggle-pin => {
                            root.toggle-pin(index);
                        }
                        open-actions => {
                            root.open-actions(index);
                        }
                    }
                }

                if root.page == Page.settings: SettingsPage {
                    width: 100%;
                    height: 100%;
                    anchor-index: root.anchor-index;
                    veil-mode: root.veil-mode;
                    veil-blur: root.veil-blur;
                    meta-key: root.meta-key;
                    meta-key-label: root.meta-key-label;
                    setup: root.setup;
                    choose-anchor(index) => {
                        root.choose-anchor(index);
                    }
                    choose-veil-mode(index) => {
                        root.choose-veil-mode(index);
                    }
                    set-veil-blur(value) => {
                        root.set-veil-blur(value);
                    }
                    set-meta-key(enabled) => {
                        root.set-meta-key(enabled);
                    }
                    install-setup => {
                        root.install-setup();
                    }
                    undo-setup => {
                        root.undo-setup();
                    }
                }
                }

                HorizontalLayout {
                    height: 40px;
                    spacing: 12px;

                    Text {
                        horizontal-stretch: 1;
                        text: root.page == Page.settings ? "Esc returns to apps" : "Ctrl+P pins, Shift+F10 shows more actions";
                        color: #c8daf877;
                        font-size: 12px;
                        vertical-alignment: center;
                    }

                    power-button := Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: 12px;
                        background: root.power-open ? #ffffff2c : (power-touch.has-hover ? #ffffff22 : #ffffff12);
                        border-width: 1px;
                        border-color: power-touch.has-hover || root.power-open ? #9be2ff77 : #ffffff26;
                        accessible-role: button;
                        accessible-label: "Power options";
                        accessible-action-default => {
                            root.power-open = !root.power-open;
                        }

                        PowerGlyph {
                            width: 20px;
                            height: 20px;
                            tint: #b8d4ff;
                        }

                        power-touch := TouchArea {
                            clicked => {
                                root.actions-open = false;
                                root.power-open = !root.power-open;
                                if (root.page == Page.apps) {
                                    search-input.focus();
                                }
                            }
                        }
                    }
                }
            }

            // While the power flyout is open, a click anywhere else in the card closes it.
            if root.power-open: TouchArea {
                width: 100%;
                height: 100%;
                clicked => {
                    root.power-open = false;
                }
            }

            // While the App Action Flyout is open, a click anywhere else in the card closes it.
            if root.actions-open: TouchArea {
                width: 100%;
                height: 100%;
                clicked => {
                    root.close-actions();
                }
                pointer-event(event) => {
                    if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                        root.close-actions();
                    }
                }
            }

            // Opens below its row, or above it when the row is near the bottom of the card.
            if root.actions-open: ActionFlyout {
                property <length> row-top: list-area.y + root.action-row * root.row-height + list.content-y;
                property <length> below: self.row-top + root.row-height + 4px;

                x: list-area.x + 52px;
                y: self.below + self.height <= parent.height - 24px
                    ? self.below
                    : max(24px, self.row-top - self.height - 4px);
                labels: root.action-labels;
                app-name: root.rows[root.action-row].text;
                current-index: root.action-index;
                choose(index) => {
                    root.choose-flyout-action(index);
                }
                highlight(index) => {
                    root.action-index = index;
                }
            }

            if root.power-open: PowerFlyout {
                x: parent.width - self.width - 24px;
                y: parent.height - 24px - 40px - 8px - self.height;
                labels: root.power-labels;
                choose(index) => {
                    root.power-open = false;
                    root.power(index);
                }
            }
        }
    }
}
