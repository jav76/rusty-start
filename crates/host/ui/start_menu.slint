import { ListView } from "std-widgets.slint";

export component StartMenu inherits Window {
    in-out property <string> query;
    in property <[StandardListViewItem]> apps;
    in-out property <int> selected-index: 0;

    in property <length> monitor-width: 1440px;
    in property <length> monitor-height: 900px;
    in property <length> card-x: 48px;
    in property <length> card-y: 90px;
    in property <float> progress: 0.0;
    // Same cubic-out curve the glass shader applies, so the card content moves with the glass body.
    property <float> ease: 1.0 - (1.0 - root.progress) * (1.0 - root.progress) * (1.0 - root.progress);
    in property <string> anchor-label: "Middle Left";

    callback dismiss();
    callback search(string);
    callback launch(int);
    callback cycle-anchor();

    /// Clears the query, restores the full list and scrolls back to the top.
    public function reset-search() {
        root.query = "";
        root.search("");
        root.selected-index = 0;
        list.content-y = 0px;
        search-input.focus();
    }

    public function focus-search() {
        search-input.focus();
    }

    function select(index: int) {
        if (root.apps.length <= 0) {
            root.selected-index = 0;
            return;
        }

        let clamped = max(0, min(index, root.apps.length - 1));
        root.selected-index = clamped;

        let row-top = clamped * 48px;
        let row-bottom = row-top + 48px;
        let visible-top = -list.content-y;
        let visible-bottom = visible-top + list.visible-height;

        if (row-top < visible-top) {
            list.content-y = -row-top;
        } else if (row-bottom > visible-bottom) {
            list.content-y = -(row-bottom - list.visible-height);
        }
    }

    title: "Rusty Start";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    width: root.monitor-width;
    height: root.monitor-height;
    forward-focus: key-scope;

    key-scope := FocusScope {
        width: 100%;
        height: 100%;

        // Capture runs before the focused search field sees the key, so these keys always reach
        // the menu while the text cursor stays in the search field.
        capture-key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.dismiss();
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.select(root.selected-index + 1);
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.select(root.selected-index - 1);
                return accept;
            }
            if (event.text == Key.Return) {
                root.launch(root.selected-index);
                return accept;
            }
            reject
        }

        // Clicking anywhere on the outer Fog Veil dismisses the Start menu.
        backdrop-touch := TouchArea {
            width: 100%;
            height: 100%;
            clicked => {
                root.dismiss();
            }
        }

        // Floating 640x720 Liquid-Glass Card container. The GPU underlay shader draws the
        // refracted glass body, chromatic bevel and specular rim directly behind this rect.
        card := Rectangle {
            x: root.card-x;
            y: root.card-y + (1.0 - root.ease) * 16px;
            width: 640px;
            height: 720px;
            transform-scale: 0.92 + 0.08 * root.ease;
            opacity: clamp(root.ease * 1.15, 0.0, 1.0);
            background: transparent;

            // Absorbs pointer clicks inside the card so they do not trigger `backdrop-touch`.
            TouchArea {
                width: 100%;
                height: 100%;
            }

            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                HorizontalLayout {
                    height: 48px;
                    spacing: 12px;

                    // Translucent glass search capsule.
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 48px;
                        border-radius: 16px;
                        background: search-input.has-focus ? #ffffff22 : #ffffff16;
                        border-width: 1px;
                        border-color: search-input.has-focus ? #9be2ff88 : #ffffff36;

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 10px;

                            Text {
                                text: "⌕";
                                color: #b8d4ff;
                                font-size: 18px;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                height: 100%;

                                if (root.query == "") : Text {
                                    width: 100%;
                                    height: 100%;
                                    text: "Search apps";
                                    color: #c8daf899;
                                    font-size: 16px;
                                    vertical-alignment: center;
                                }

                                search-input := TextInput {
                                    width: 100%;
                                    height: 100%;
                                    text <=> root.query;
                                    color: #f6f9ff;
                                    font-size: 16px;
                                    vertical-alignment: center;
                                    single-line: true;
                                    edited => {
                                        root.search(self.text);
                                        root.selected-index = 0;
                                        list.content-y = 0px;
                                    }
                                    accepted => {
                                        root.launch(root.selected-index);
                                    }
                                }
                            }
                        }
                    }

                    // Subtle glass pill to cycle the card anchor position on screen.
                    Rectangle {
                        width: 132px;
                        height: 48px;
                        border-radius: 16px;
                        background: anchor-touch.has-hover ? #ffffff2c : #ffffff16;
                        border-width: 1px;
                        border-color: anchor-touch.has-hover ? #9be2ff77 : #ffffff30;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 6px;
                            alignment: center;

                            Text {
                                text: "⌖";
                                color: #9be2ff;
                                font-size: 14px;
                                vertical-alignment: center;
                            }

                            Text {
                                text: root.anchor-label;
                                color: #e4effe;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }

                        anchor-touch := TouchArea {
                            clicked => {
                                root.cycle-anchor();
                                search-input.focus();
                            }
                        }
                    }
                }

                // Virtualized translucent glass app list.
                list := ListView {
                    vertical-stretch: 1;

                    for item[index] in root.apps : Rectangle {
                        height: 48px;
                        width: parent.width;
                        background: transparent;

                        Rectangle {
                            x: 2px;
                            y: 2px;
                            width: parent.width - 4px;
                            height: 44px;
                            border-radius: 12px;
                            background: index == root.selected-index
                                ? #7cc8ff36
                                : (row-touch.has-hover ? #ffffff1c : transparent);
                            border-width: (index == root.selected-index || row-touch.has-hover) ? 1px : 0px;
                            border-color: index == root.selected-index ? #aee6ff88 : #ffffff2e;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 12px;

                                Rectangle {
                                    width: 3px;
                                    height: 18px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 1.5px;
                                    background: index == root.selected-index ? #7dd3fc : transparent;
                                }

                                Text {
                                    horizontal-stretch: 1;
                                    text: item.text;
                                    color: index == root.selected-index ? #ffffff : #e6f0ff;
                                    font-size: 15px;
                                    font-weight: index == root.selected-index ? 600 : 400;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }

                        row-touch := TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => {
                                root.selected-index = index;
                                root.launch(index);
                            }
                        }
                    }
                }
            }
        }
    }
}
